const faqs = [
  {
    question: 'Why replace TinyEmail for Shopify SMS?',
    answer: 'Common reasons include unclear message economics, insufficient quiet-hour or consent controls, weak Shopify event context, or a need to separate SMS urgency from email lifecycle education.',
  },
  {
    question: 'Can email permission be reused for SMS?',
    answer: 'No. Treat SMS consent separately. Preserve opt-in source, timestamp, message type, opt-outs, quiet hours, and suppression state.',
  },
  {
    question: 'How should I migrate?',
    answer: 'Export and validate consent first, rebuild cart recovery, test STOP handling and quiet hours, then add launch, replenishment, and winback flows with a collision calendar.',
  },
